# =============================================================================
# .env.example — Template variables environnement Bendimu Experiments
# Copier vers .env et remplir. NE JAMAIS COMMIT .env.
# =============================================================================

# ---- GCP ----
GCP_PROJECT_ID="ton-projet-gcp-id"
GCP_PROJECT_NUMBER="123456789012"
GCP_BILLING_ACCOUNT="XXXXXX-XXXXXX-XXXXXX"
GCP_REGION="europe-west9"
GCP_ZONE="europe-west9-a"

# ---- Service Account ----
# Chemin absolu vers clé JSON du service account
GOOGLE_APPLICATION_CREDENTIALS="/home/stivax/.gcp/bendimu-sa-key.json"
GCP_SERVICE_ACCOUNT_EMAIL="bendimu-terraform@ton-projet-gcp-id.iam.gserviceaccount.com"

# ---- Terraform state backend ----
TF_BACKEND_BUCKET="bendimu-tfstate-ton-projet"
TF_BACKEND_PREFIX_V0="v0-bremler"
TF_BACKEND_PREFIX_V1="v1-bendimu"
TF_BACKEND_PREFIX_V2="v2-bendimu-recherche"

# ---- Cluster naming ----
CLUSTER_NAME_V0="bremler-v0"
CLUSTER_NAME_V1="bendimu-v1"
CLUSTER_NAME_V2="bendimu-v2"

# ---- Versions figées ----
# V0 (Bremler-Barr 2024)
V0_K8S_VERSION="1.29.9-gke.1000000"
V0_ISTIO_VERSION="1.22.6"
V0_CILIUM_VERSION="1.15.10"

# V1/V2 (récent)
V1_K8S_VERSION="1.30.5-gke.1355000"
V1_ISTIO_VERSION="1.24.0"
V1_CILIUM_VERSION="1.16.5"

# ---- Docker registry (pour rebuild simulated_tls_server PSD2) ----
DOCKER_REGISTRY="gcr.io/ton-projet-gcp-id"
TLS_SERVER_IMAGE_TAG="0.0.4-psd2"

# ---- Budget alerts ----
BUDGET_TOTAL_USD="300"
BUDGET_ALERT_THRESHOLDS="50,80,95"
BUDGET_ALERT_EMAIL="stive.chameni@facsciences-uy1.cm"

# Compte Google avec les crédits GCP (compte académique UY1). Utiliser pour gcloud auth.
GCP_ACCOUNT="stive.chameni@facsciences-uy1.cm"

# ---- Fortio charge ----
FORTIO_CONNECTIONS_MAX="1000"
FORTIO_RPS_TARGET="12800"
FORTIO_DURATION_S="300"
FORTIO_ITERATIONS="5"
FORTIO_QUIET_TIME_S="120"

# ---- OBP audit (V2 amend. 4) ----
OBP_LOCAL_URL="http://localhost:8080"

# ---- Bank of Anthos (V2 amend. 9) ----
BOA_NAMESPACE="boa"
