# =============================================================================
# .env.example — Template variables environnement Bendimu Experiments
# Copier vers .env et remplir. NE JAMAIS COMMIT .env.
# =============================================================================

# ---- GCP ----
export GCP_PROJECT_ID="bendimu-mesh-bench"
export GCP_PROJECT_NUMBER="123456789012"
export GCP_BILLING_ACCOUNT="0133B5-B199F1-9FB8C3"
export GCP_REGION="europe-west1"
export GCP_ZONE="europe-west1-b"

# Compte académique UY1 avec crédits GCP (utiliser pour gcloud auth)
export GCP_ACCOUNT="stive.chameni@facsciences-uy1.cm"

# ---- Service Account ----
# Pas de clé JSON téléchargée : on utilise application-default + impersonation.
export GCP_SERVICE_ACCOUNT_EMAIL="terraform-bendimu@bendimu-mesh-bench.iam.gserviceaccount.com"

# ---- Terraform state backend ----
export TF_BACKEND_BUCKET="bendimu-tfstate-bendimu-mesh-bench"
export TF_BACKEND_PREFIX_V0="v0-bremler"
export TF_BACKEND_PREFIX_V1="v1-bendimu"
export TF_BACKEND_PREFIX_V2="v2-bendimu-recherche"

# ---- Cluster naming ----
export CLUSTER_NAME_V0="bremler-v0"
export CLUSTER_NAME_V1="bendimu-v1"
export CLUSTER_NAME_V2="bendimu-v2"

# ---- Versions figées (alignées Bremler-Barr 2024 pour V0, récentes pour V1/V2) ----
# V0 (fidélité artefact publication)
export V0_K8S_VERSION="1.35.6-gke.1250000"
export V0_ISTIO_VERSION="1.22.6"
export V0_CILIUM_VERSION="1.16.3"

# V1/V2 (versions courantes)
export V1_K8S_VERSION="1.35.6-gke.1250000"
export V1_ISTIO_VERSION="1.24.0"
export V1_CILIUM_VERSION="1.16.3"

# ---- Artifact Registry (image sut-v1 PSD2) ----
export DOCKER_REGISTRY="europe-west1-docker.pkg.dev/bendimu-mesh-bench/bendimu-images"
export TLS_SERVER_IMAGE_TAG="1.0.0"

# ---- Budget + alertes ----
# Crédit disponible UY1 = 300 USD. Alerte hard cap = 300 USD (100 % crédit)
# Seuils 50 % / 80 % / 95 % → 150 / 240 / 285 USD
export BUDGET_TOTAL_USD="300"
export BUDGET_ALERT_THRESHOLDS="50,80,95"
export BUDGET_ALERT_EMAIL="stive.chameni@facsciences-uy1.cm"

# ---- Fortio charge ----
export FORTIO_CONNECTIONS_MAX="1000"
export FORTIO_RPS_TARGET="12800"
export FORTIO_DURATION_S="120"
export FORTIO_ITERATIONS="3"
export FORTIO_QUIET_TIME_S="30"

# ---- Campagne tracking ----
export CAMPAIGN_ID="v0-baseline"
export AUTO_SHUTDOWN_HOUR="22"

# ---- OBP audit (V2 amendement 04) ----
export OBP_LOCAL_URL="http://localhost:8080"

# ---- Bank of Anthos (V2 amendement 09) ----
export BOA_NAMESPACE="boa"
export BOA_VERSION="release/v0.6.5"

# ---- GitHub (pour WIF Actions) ----
export GITHUB_ORG="chamenistive"
export GITHUB_REPO="bendimu-experiments"
